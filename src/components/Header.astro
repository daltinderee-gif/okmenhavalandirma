---
import { products } from '../data/products';
import { decorationServices } from '../data/decoration';
import { sectors } from '../data/sectors';

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));

const regions = [
  { slug: 'diyarbakir-havalandirma', title: 'Diyarbakır' },
  { slug: 'sanliurfa-havalandirma', title: 'Şanlıurfa' },
  { slug: 'batman-havalandirma', title: 'Batman' },
  { slug: 'mardin-havalandirma', title: 'Mardin' },
  { slug: 'gaziantep-havalandirma', title: 'Gaziantep' },
  { slug: 'elazig-havalandirma', title: 'Elazığ' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-40 transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-slate-100"
>
  <div class="bg-primary text-white text-xs">
    <div class="container-x flex items-center justify-between py-2">
      <div class="hidden sm:flex items-center gap-4 opacity-90">
        <a href="tel:+905309009344" class="flex items-center gap-1.5 hover:text-accent transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.9L8.09 10.91a16 16 0 006 6l1.69-1.38a2 2 0 011.9-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A17 17 0 013 5z"/>
          </svg>
          +90 530 900 93 44
        </a>
        <a href="mailto:info@okmenhavalandirma.com" class="flex items-center gap-1.5 hover:text-accent transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          info@okmenhavalandirma.com
        </a>
      </div>
      <div class="flex items-center gap-3 opacity-90">
        <span class="hidden md:inline">Pzt-Cmt 08:00-18:00</span>
        <span class="hidden md:inline opacity-50">|</span>
        <a href="/iletisim/" class="hover:text-accent transition">Hızlı Teklif</a>
      </div>
    </div>
  </div>

  <div class="container-x">
    <div class="flex items-center justify-between h-24 md:h-28">
      <a href="/" class="flex items-center gap-3 group" aria-label="Ökmen Havalandırma Ana Sayfa">
        <img src="/logo.png" alt="Ökmen Havalandırma" width="600" height="400" class="h-20 md:h-24 w-auto transition group-hover:scale-105" />
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Ana navigasyon">
        <a
          href="/"
          class={`px-4 py-2 text-sm font-medium rounded-md transition ${isActive('/') && path === '/' ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
        >Ana Sayfa</a>

        <!-- HAVALANDIRMA mega menu -->
        <div class="relative group">
          <a
            href="/urunler/"
            class={`px-4 py-2 text-sm font-semibold rounded-md transition flex items-center gap-1 ${isActive('/urunler') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
          >
            Havalandırma
            <svg class="w-3 h-3 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute top-full left-0 mt-1 w-[680px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-card-hover border border-slate-100 p-6">
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <div>
                  <div class="text-[10px] uppercase tracking-[0.2em] text-accent font-bold">Marka 1</div>
                  <div class="font-serif text-lg font-bold text-primary">Ökmen Havalandırma</div>
                </div>
                <a href="/urunler/" class="text-xs font-semibold text-primary hover:text-secondary transition">Tüm Ürünler →</a>
              </div>
              <div class="grid grid-cols-2 gap-x-6 gap-y-1">
                {products.map((p) => (
                  <a href={`/urunler/${p.slug}/`} class="flex items-start gap-3 p-2 rounded-lg hover:bg-pale/30 transition group/item">
                    <span class="mt-1 w-2 h-2 rounded-full bg-accent group-hover/item:bg-primary transition flex-shrink-0"></span>
                    <div class="text-sm font-medium text-slate-700 group-hover/item:text-primary">{p.title}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- DEKORASYON mega menu -->
        <div class="relative group">
          <a
            href="/yapi-dekorasyon/"
            class={`px-4 py-2 text-sm font-semibold rounded-md transition flex items-center gap-1 ${isActive('/yapi-dekorasyon') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
          >
            Yapı & Dekorasyon
            <svg class="w-3 h-3 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-[520px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-card-hover border border-slate-100 p-6">
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <div>
                  <div class="text-[10px] uppercase tracking-[0.2em] text-accent font-bold">Marka 2</div>
                  <div class="font-serif text-lg font-bold text-primary">Mir Dekorasyon</div>
                </div>
                <a href="/yapi-dekorasyon/" class="text-xs font-semibold text-primary hover:text-secondary transition">Tüm Hizmetler →</a>
              </div>
              <div class="grid grid-cols-2 gap-x-6 gap-y-1">
                {decorationServices.map((s) => (
                  <a href={`/yapi-dekorasyon/${s.slug}/`} class="flex items-start gap-3 p-2 rounded-lg hover:bg-pale/30 transition group/item">
                    <span class="mt-1 w-2 h-2 rounded-full bg-accent group-hover/item:bg-primary transition flex-shrink-0"></span>
                    <div class="text-sm font-medium text-slate-700 group-hover/item:text-primary">{s.title}</div>
                  </a>
                ))}
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-4 text-[11px] text-slate-500">
                <span>Web siteleri:</span>
                <a href="https://mirdekorasyon.com" target="_blank" rel="noopener" class="hover:text-primary font-mono">mirdekorasyon.com</a>
                <a href="https://mirdekorasyon.com.tr" target="_blank" rel="noopener" class="hover:text-primary font-mono">.com.tr</a>
              </div>
            </div>
          </div>
        </div>

        <div class="relative group">
          <a
            href="/bolgeler/diyarbakir-havalandirma/"
            class={`px-4 py-2 text-sm font-medium rounded-md transition flex items-center gap-1 ${isActive('/bolgeler') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
          >
            Bölgeler
            <svg class="w-3 h-3 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-card-hover border border-slate-100 p-3">
              {regions.map((r) => (
                <a href={`/bolgeler/${r.slug}/`} class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-pale/30 transition text-sm font-medium text-slate-700 hover:text-primary">
                  <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  {r.title}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- İŞLETMELER mega menu -->
        <div class="relative group">
          <a
            href="/isletmeler/"
            class={`px-4 py-2 text-sm font-semibold rounded-md transition flex items-center gap-1 ${isActive('/isletmeler') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
          >
            İşletmeler
            <svg class="w-3 h-3 transition group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-card-hover border border-slate-100 p-3">
              <div class="px-2 pb-2 mb-1 border-b border-slate-100">
                <div class="text-[10px] uppercase tracking-[0.2em] text-accent font-bold">Sektörel Paket</div>
                <div class="text-xs text-slate-500 mt-0.5">İşletmenizi seçin → paket önerimizi görün</div>
              </div>
              {sectors.map((s) => (
                <a href={`/isletmeler/${s.slug}/`} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-pale/30 transition group/item">
                  <span class="text-xl flex-shrink-0">{s.emoji}</span>
                  <div>
                    <div class="text-sm font-semibold text-primary group-hover/item:text-secondary">{s.title}</div>
                    <div class="text-[11px] text-slate-500">{s.short}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a
          href="/hakkimizda/"
          class={`px-4 py-2 text-sm font-medium rounded-md transition ${isActive('/hakkimizda') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
        >Hakkımızda</a>
        <a
          href="/galeri/"
          class={`px-4 py-2 text-sm font-medium rounded-md transition ${isActive('/galeri') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
        >Galeri</a>
        <a
          href="/blog/"
          class={`px-4 py-2 text-sm font-medium rounded-md transition ${isActive('/blog') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
        >Blog</a>
        <a
          href="/iletisim/"
          class={`px-4 py-2 text-sm font-medium rounded-md transition ${isActive('/iletisim') ? 'text-primary bg-pale/40' : 'text-slate-700 hover:text-primary hover:bg-slate-50'}`}
        >İletişim</a>
      </nav>

      <div class="hidden lg:flex items-center gap-2">
        <a href="tel:+905309009344" class="btn-primary text-sm py-2 px-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.9L8.09 10.91a16 16 0 006 6l1.69-1.38a2 2 0 011.9-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A17 17 0 013 5z"/>
          </svg>
          Hemen Ara
        </a>
      </div>

      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-lg hover:bg-slate-100 transition"
        aria-label="Menüyü aç"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 text-primary hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-slate-100 bg-white max-h-[calc(100vh-5rem)] overflow-y-auto">
    <nav class="container-x py-4 flex flex-col gap-1">
      <a href="/" class="px-3 py-3 rounded-lg hover:bg-pale/40 font-medium text-slate-700 hover:text-primary">Ana Sayfa</a>

      <details class="group">
        <summary class="px-3 py-3 rounded-lg hover:bg-pale/40 font-semibold text-slate-700 cursor-pointer flex items-center justify-between list-none">
          <span>Havalandırma</span>
          <svg class="w-4 h-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="pl-3 mt-1 grid grid-cols-1 gap-0.5">
          <a href="/urunler/" class="px-3 py-2 text-sm font-semibold text-primary">Tüm Ürünler →</a>
          {products.map((p) => (
            <a href={`/urunler/${p.slug}/`} class="px-3 py-2 text-sm text-slate-600 hover:text-primary hover:bg-pale/30 rounded">{p.title}</a>
          ))}
        </div>
      </details>

      <details class="group">
        <summary class="px-3 py-3 rounded-lg hover:bg-pale/40 font-semibold text-slate-700 cursor-pointer flex items-center justify-between list-none">
          <span>Yapı & Dekorasyon</span>
          <svg class="w-4 h-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="pl-3 mt-1 grid grid-cols-1 gap-0.5">
          <a href="/yapi-dekorasyon/" class="px-3 py-2 text-sm font-semibold text-primary">Mir Dekorasyon Ana Sayfa →</a>
          {decorationServices.map((s) => (
            <a href={`/yapi-dekorasyon/${s.slug}/`} class="px-3 py-2 text-sm text-slate-600 hover:text-primary hover:bg-pale/30 rounded">{s.title}</a>
          ))}
        </div>
      </details>

      <details class="group">
        <summary class="px-3 py-3 rounded-lg hover:bg-pale/40 font-medium text-slate-700 cursor-pointer flex items-center justify-between list-none">
          <span>Bölgeler</span>
          <svg class="w-4 h-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="pl-3 mt-1 flex flex-col gap-0.5">
          {regions.map((r) => (
            <a href={`/bolgeler/${r.slug}/`} class="px-3 py-2 text-sm text-slate-600 hover:text-primary hover:bg-pale/30 rounded">{r.title}</a>
          ))}
        </div>
      </details>

      <details class="group">
        <summary class="px-3 py-3 rounded-lg hover:bg-pale/40 font-semibold text-slate-700 cursor-pointer flex items-center justify-between list-none">
          <span>İşletmeler</span>
          <svg class="w-4 h-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="pl-3 mt-1 grid grid-cols-1 gap-0.5">
          <a href="/isletmeler/" class="px-3 py-2 text-sm font-semibold text-primary">Tüm Sektörler →</a>
          {sectors.map((s) => (
            <a href={`/isletmeler/${s.slug}/`} class="px-3 py-2 text-sm text-slate-600 hover:text-primary hover:bg-pale/30 rounded flex items-center gap-2">
              <span>{s.emoji}</span>
              {s.title}
            </a>
          ))}
        </div>
      </details>

      <a href="/hakkimizda/" class="px-3 py-3 rounded-lg hover:bg-pale/40 font-medium text-slate-700 hover:text-primary">Hakkımızda</a>
      <a href="/galeri/" class="px-3 py-3 rounded-lg hover:bg-pale/40 font-medium text-slate-700 hover:text-primary">Galeri</a>
      <a href="/blog/" class="px-3 py-3 rounded-lg hover:bg-pale/40 font-medium text-slate-700 hover:text-primary">Blog</a>
      <a href="/iletisim/" class="px-3 py-3 rounded-lg hover:bg-pale/40 font-medium text-slate-700 hover:text-primary">İletişim</a>

      <a href="tel:+905309009344" class="btn-primary mt-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.9L8.09 10.91a16 16 0 006 6l1.69-1.38a2 2 0 011.9-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A17 17 0 013 5z"/>
        </svg>
        +90 530 900 93 44
      </a>
    </nav>
  </div>
</header>

<div class="h-[8.5rem] md:h-[9rem]"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Header shadow on scroll
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (window.scrollY > 10) header?.classList.add('shadow-md');
    else header?.classList.remove('shadow-md');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

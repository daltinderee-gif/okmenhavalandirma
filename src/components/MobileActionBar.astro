---
// Mobile-only sticky bottom action bar
// One-tap call + WhatsApp — the highest-converting pattern for service businesses
const phone = '+905309009344';
const phoneDigits = '905309009344';
const waMessage = encodeURIComponent('Merhaba, Ökmen Havalandırma için teklif almak istiyorum.');
---

<div class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-slate-200 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
  <div class="grid grid-cols-2 divide-x divide-slate-200">
    <a
      href={`tel:${phone}`}
      class="flex items-center justify-center gap-2 py-3.5 text-primary font-semibold text-sm hover:bg-pale/30 transition active:bg-pale/50"
      aria-label="Hemen ara"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.9L8.09 10.91a16 16 0 006 6l1.69-1.38a2 2 0 011.9-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A17 17 0 013 5z"/>
      </svg>
      <span>Hemen Ara</span>
    </a>

    <a
      href={`https://wa.me/${phoneDigits}?text=${waMessage}`}
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center gap-2 py-3.5 bg-[#25D366] text-white font-semibold text-sm hover:bg-[#1ebe57] transition active:bg-[#179a48]"
      aria-label="WhatsApp'tan yaz"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M20.5 3.5A11.94 11.94 0 0012 0C5.4 0 .03 5.37.03 11.97c0 2.1.55 4.16 1.6 5.98L0 24l6.22-1.62a11.97 11.97 0 005.78 1.47h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.48-8.38zM12 21.8c-1.85 0-3.66-.5-5.24-1.43l-.38-.22-3.7.97.99-3.6-.25-.37A9.85 9.85 0 012.2 11.97C2.2 6.57 6.6 2.17 12 2.17s9.8 4.4 9.8 9.8c0 5.4-4.4 9.83-9.8 9.83z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
</div>

<!-- Spacer so content isn't hidden behind the bar -->
<div class="md:hidden h-14"></div>

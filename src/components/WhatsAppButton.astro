---
const phone = '905309009344';
const message = encodeURIComponent('Merhaba, Ökmen Havalandırma ürünleriniz hakkında bilgi almak istiyorum.');
const href = `https://wa.me/${phone}?text=${message}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp'tan yaz"
  class="fixed bottom-6 right-6 z-50 group"
>
  <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-40 animate-ping"></span>
  <span class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#1ebe57] text-white shadow-lg transition-transform group-hover:scale-110">
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 3.5A11.94 11.94 0 0012 0C5.4 0 .03 5.37.03 11.97c0 2.1.55 4.16 1.6 5.98L0 24l6.22-1.62a11.97 11.97 0 005.78 1.47h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.48-8.38zM12 21.8c-1.85 0-3.66-.5-5.24-1.43l-.38-.22-3.7.97.99-3.6-.25-.37A9.85 9.85 0 012.2 11.97C2.2 6.57 6.6 2.17 12 2.17s9.8 4.4 9.8 9.8c0 5.4-4.4 9.83-9.8 9.83zm5.36-7.33c-.29-.15-1.74-.86-2.01-.96-.27-.1-.47-.15-.66.15-.2.29-.76.96-.93 1.16-.17.2-.34.22-.63.07-.29-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.03-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.51-.07-.15-.66-1.6-.91-2.18-.24-.58-.49-.5-.66-.51l-.56-.01c-.2 0-.51.07-.78.37-.27.29-1.02.99-1.02 2.42 0 1.43 1.04 2.81 1.18 3 .15.2 2.05 3.13 4.96 4.39.69.3 1.24.48 1.66.62.7.22 1.33.19 1.83.11.56-.08 1.74-.71 1.98-1.4.24-.69.24-1.27.17-1.4-.07-.13-.27-.2-.56-.34z"/>
    </svg>
  </span>
  <span class="hidden md:block absolute right-full top-1/2 -translate-y-1/2 mr-3 bg-white text-primary text-sm font-medium px-3 py-2 rounded-lg shadow-card whitespace-nowrap opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition pointer-events-none">
    WhatsApp Destek Hattı

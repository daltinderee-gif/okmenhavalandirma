---
import { products } from '../data/products';

export interface Props {
  variant?: 'default' | 'compact';
  defaultService?: string;
}

const { variant = 'default', defaultService = '' } = Astro.props as Props;
const isCompact = variant === 'compact';

// Web3Forms — ücretsiz form-to-email servisi (Turhost gibi static host'ta çalışır)
// 1) https://web3forms.com/ adresine git
// 2) info@okmenhavalandirma.com mail adresini gir → "Create Access Key"
// 3) Mail'e gelen access key'i aşağıya yapıştır
// Eğer ACCESS_KEY 'BURAYA-...' kalırsa form yine de görünür ama gönderim yapmaz.
const WEB3FORMS_ACCESS_KEY = '821ee67d-70a8-460d-96e1-ec9976764310';
---

<form
  name="contact"
  method="POST"
  action="https://api.web3forms.com/submit"
  class={`bg-white rounded-2xl shadow-card p-6 md:p-8 ${isCompact ? '' : ''}`}
>
  <!-- Web3Forms access key -->
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="Ökmen Havalandırma — Yeni Teklif Talebi" />
  <input type="hidden" name="from_name" value="okmenhavalandirma.com formu" />
  <input type="hidden" name="redirect" value="https://okmenhavalandirma.com/iletisim?gonderildi=1" />
  <!-- Bot tuzağı (honeypot) -->
  <p class="hidden" aria-hidden="true">
    <label>Boş bırakın: <input name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" /></label>
  </p>

  {!isCompact && (
    <div class="mb-6">
      <h3 class="font-serif text-2xl md:text-3xl font-bold text-primary mb-2">Hızlı Teklif Formu</h3>
      <p class="text-sm text-slate-600">Formu doldurun, 24 saat içinde size dönelim.</p>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="cf-name" class="block text-sm font-medium text-slate-700 mb-1.5">Ad Soyad *</label>
      <input
        id="cf-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
        placeholder="Adınız Soyadınız"
      />
    </div>

    <div>
      <label for="cf-phone" class="block text-sm font-medium text-slate-700 mb-1.5">Telefon *</label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
        placeholder="0 5__ ___ __ __"
      />
    </div>

    <div>
      <label for="cf-email" class="block text-sm font-medium text-slate-700 mb-1.5">E-posta</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
        placeholder="ornek@email.com"
      />
    </div>

    <div>
      <label for="cf-city" class="block text-sm font-medium text-slate-700 mb-1.5">Şehir</label>
      <input
        id="cf-city"
        name="city"
        type="text"
        autocomplete="address-level2"
        class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
        placeholder="Diyarbakır"
      />
    </div>

    <div class="md:col-span-2">
      <label for="cf-service" class="block text-sm font-medium text-slate-700 mb-1.5">Hizmet Türü</label>
      <select
        id="cf-service"
        name="service"
        class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition bg-white"
      >
        <option value="">— Seçiniz —</option>
        {products.map((p) => (
          <option value={p.title} selected={p.title === defaultService}>{p.title}</option>
        ))}
        <option value="Diğer">Diğer / Belirtmek istiyorum</option>
      </select>
    </div>

    <div class="md:col-span-2">
      <label for="cf-message" class="block text-sm font-medium text-slate-700 mb-1.5">Mesajınız</label>
      <textarea
        id="cf-message"
        name="message"
        rows={isCompact ? 3 : 5}
        class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition resize-none"
        placeholder="Projeniz veya talebiniz hakkında kısa bilgi verin..."
      ></textarea>
    </div>
  </div>

  <div class="mt-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <p class="text-xs text-slate-500">
      Formu göndererek <a href="/aydinlatma-metni/" class="underline hover:text-primary">aydınlatma metnini</a> kabul etmiş sayılırsınız.
    </p>
    <button type="submit" class="btn-primary w-full sm:w-auto">
      Teklif Talebi Gönder
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </button>
  </div>
</form>

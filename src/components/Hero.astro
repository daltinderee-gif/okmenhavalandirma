---
const slides = [
  {
    image: 'https://images.pexels.com/photos/29802716/pexels-photo-29802716.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=2400',
    eyebrow: 'Diyarbakır · Türkiye Geneli',
    titleTop: "Diyarbakır'ın",
    titleBig: 'Havalandırma',
    titleAccent: 'Uzmanı',
    subtitle: 'Restoran, cafe, mağaza, ofis, otel veya fabrika — işletmeniz hangi olursa olsun havalandırmadan tadilata tek çatı altında çözüm.',
    cta1: { href: '/isletmeler', label: 'İşletmenize Özel Paket', external: false },
    cta2: { href: 'https://wa.me/905309009344', label: 'WhatsApp\'tan Yaz', external: true },
  },
  {
    image: 'https://images.pexels.com/photos/13109834/pexels-photo-13109834.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=2400',
    eyebrow: 'Eurovent Sertifikalı',
    titleTop: 'Klima Santrali',
    titleBig: '& AHU',
    titleAccent: 'Sistemleri',
    subtitle: 'Modüler santraller — 1.000 ile 100.000 m³/h arası tüm kapasitelerde proje, imalat ve anahtar teslim montaj.',
    cta1: { href: '/urunler/klima-santrali', label: 'Klima Santrali', external: false },
    cta2: { href: '/iletisim', label: 'Mühendis Görüşmesi', external: false },
  },
  {
    image: 'https://images.pexels.com/photos/13806340/pexels-photo-13806340.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=2400',
    eyebrow: 'Endüstriyel Filtrasyon',
    titleTop: 'Toz Toplama',
    titleBig: 'Jet-Pulse',
    titleAccent: 'Sistemleri',
    subtitle: '%99,9 verimli filtreleme — metal işleme, ahşap, gıda, kimya ve çimento tesisleri için temiz üretim alanı.',
    cta1: { href: '/urunler/toz-toplama-sistemleri', label: 'Detaylı Bilgi', external: false },
    cta2: { href: '/iletisim', label: 'Ücretsiz Keşif', external: false },
  },
  {
    image: 'https://images.pexels.com/photos/33986701/pexels-photo-33986701.png?auto=compress&cs=tinysrgb&dpr=2&h=650&w=2400',
    eyebrow: 'Restoran & Cafe Açılış',
    titleTop: 'Restoran ya da Cafe',
    titleBig: 'Açıyor',
    titleAccent: 'musunuz?',
    subtitle: 'Davlumbaz, baca, koku tutma ve klima — açılış için gereken tüm havalandırma sistemi 15 günde anahtar teslim. Belediye belgeleri dahil.',
    cta1: { href: '/isletmeler/restoran-cafe', label: 'Restoran Paketini Gör', external: false },
    cta2: { href: 'https://wa.me/905309009344', label: 'WhatsApp\'tan Sor', external: true },
  },
  {
    image: 'https://images.pexels.com/photos/269218/pexels-photo-269218.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=2400',
    eyebrow: 'İki Marka · Tek Çatı',
    titleTop: 'Havalandırma + Dekorasyon',
    titleBig: 'Tek',
    titleAccent: 'Adres',
    subtitle: 'Ökmen Havalandırma + Mir Dekorasyon birleşik — tadilat, asma tavan, boya, klima ve havalandırma. Restoranınız, mağazanız veya ofisiniz için tek koordinasyon.',
    cta1: { href: '/yapi-dekorasyon', label: 'Mir Dekorasyon\'u Keşfet', external: false },
    cta2: { href: '/urunler', label: 'Havalandırma Ürünleri', external: false },
  },
];

const trustBadges = [
  { value: '500+', label: 'Tamamlanan Proje' },
  { value: '15+', label: 'Yıllık Tecrübe' },
  { value: '20+', label: 'Ürün Kategorisi' },
  { value: '7/24', label: 'Servis Desteği' },
];
---

<section
  class="relative h-[94vh] min-h-[680px] max-h-[960px] -mt-[8.5rem] md:-mt-[9rem] overflow-hidden bg-primary"
  aria-label="Tanıtım"
>
  <!-- Slides -->
  <div id="hero-slider" class="absolute inset-0">
    {slides.map((slide, i) => (
      <div
        class={`hero-slide absolute inset-0 transition-opacity duration-[1400ms] ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
        data-index={i}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <div
          class="hero-bg absolute inset-0 bg-cover bg-center hero-photo"
          style={`background-image: url('${slide.image}')`}
        ></div>
        <div class="hero-vignette absolute inset-0"></div>
        <div class="grain absolute inset-0"></div>
      </div>
    ))}
  </div>

  <!-- Decorative fan watermark (subtle, top right) -->
  <div class="absolute top-24 right-6 md:right-12 w-40 h-40 md:w-72 md:h-72 opacity-[0.08] pointer-events-none z-10 hidden sm:block">
    <svg viewBox="0 0 200 200" class="w-full h-full text-white animate-[spin_40s_linear_infinite]">
      <g transform="translate(100,100)" fill="currentColor">
        <ellipse cx="0" cy="-55" rx="22" ry="48" transform="rotate(0)"/>
        <ellipse cx="0" cy="-55" rx="22" ry="48" transform="rotate(72)"/>
        <ellipse cx="0" cy="-55" rx="22" ry="48" transform="rotate(144)"/>
        <ellipse cx="0" cy="-55" rx="22" ry="48" transform="rotate(216)"/>
        <ellipse cx="0" cy="-55" rx="22" ry="48" transform="rotate(288)"/>
        <circle cx="0" cy="0" r="20"/>
      </g>
    </svg>
  </div>


  <!-- Slide text content — same overlay for all slides, cycled via data attrs -->
  <div class="relative h-full container-x flex flex-col justify-end pb-40 md:pb-48 pt-[10rem] z-20">
    {slides.map((slide, i) => (
      <div
        class={`hero-text absolute left-4 right-4 md:left-8 md:right-8 lg:left-12 lg:right-12 bottom-[10rem] md:bottom-[12rem] transition-all duration-[1000ms] ${i === 0 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4 pointer-events-none'}`}
        data-index={i}
      >
        <div class="max-w-5xl text-white">
          <div class="accent-strip mb-5">
            <span class="text-xs uppercase tracking-[0.22em] font-semibold text-accent">{slide.eyebrow}</span>
          </div>

          <h1 class="display-headline text-balance mb-6 max-w-4xl">
            <span class="block text-xl sm:text-2xl md:text-3xl font-medium text-pale/85 mb-2">{slide.titleTop}</span>
            <span class="block text-mega">
              {slide.titleBig}
              <span class="text-accent"> {slide.titleAccent}</span>
            </span>
          </h1>

          <p class="text-base sm:text-lg md:text-xl text-pale/95 mb-8 max-w-2xl text-pretty leading-relaxed">
            {slide.subtitle}
          </p>

          <div class="flex flex-wrap gap-3">
            <a
              href={slide.cta1.href}
              target={slide.cta1.external ? '_blank' : undefined}
              rel={slide.cta1.external ? 'noopener' : undefined}
              class="btn-accent text-base shadow-2xl hover:shadow-xl hover:-translate-y-0.5 px-7 py-3.5"
            >
              {slide.cta1.label}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a
              href={slide.cta2.href}
              target={slide.cta2.external ? '_blank' : undefined}
              rel={slide.cta2.external ? 'noopener' : undefined}
              class="btn-ghost text-base px-7 py-3.5"
            >
              {slide.cta2.label}
            </a>
          </div>

          <!-- Müşteri-kazandıran promise satırı -->
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-pale/90 text-sm">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span><strong class="text-white">5 dakika</strong> içinde geri dönüş</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              <span><strong class="text-white">Ücretsiz</strong> keşif & hesap</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span><strong class="text-white">2 yıl</strong> tam garanti</span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom bar: dots, nav, stats -->
  <div class="absolute bottom-0 left-0 right-0 z-30">
    <!-- Slide indicators + nav -->
    <div class="container-x pb-4">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2" role="tablist" aria-label="Slider sekmeleri">
          {slides.map((_, i) => (
            <button
              class={`hero-dot h-1.5 transition-all duration-500 rounded-full ${i === 0 ? 'w-16 bg-accent' : 'w-6 bg-white/30 hover:bg-white/60'}`}
              data-index={i}
              aria-label={`Slide ${i + 1}`}
              role="tab"
            ></button>
          ))}
          <span class="ml-3 text-xs text-white/60 font-mono tabular-nums">
            <span id="hero-current">01</span> / {String(slides.length).padStart(2, '0')}
          </span>
        </div>

        <div class="hidden md:flex items-center gap-3">
          <button id="hero-prev" class="w-11 h-11 rounded-full bg-white/10 border border-white/25 backdrop-blur hover:bg-white hover:text-primary text-white transition flex items-center justify-center" aria-label="Önceki">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button id="hero-next" class="w-11 h-11 rounded-full bg-white/10 border border-white/25 backdrop-blur hover:bg-white hover:text-primary text-white transition flex items-center justify-center" aria-label="Sonraki">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Stats strip - floating glass row, full bleed -->
    <div class="bg-primary/40 backdrop-blur-md border-t border-white/15">
      <div class="container-x">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/15">
          {trustBadges.map((b) => (
            <div class="py-4 md:py-5 text-center md:text-left md:pl-6 first:pl-0">
              <div class="font-serif text-2xl md:text-3xl font-bold text-white leading-none">
                {b.value}
              </div>
              <div class="text-[10px] md:text-xs uppercase tracking-[0.18em] text-pale/70 mt-1.5">
                {b.label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    transform: scale(1.08);
    transition: transform 9000ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-slide.opacity-100 .hero-bg {
    transform: scale(1);
  }
</style>

<script>
  const slidesEls = document.querySelectorAll<HTMLElement>('.hero-slide');
  const textEls = document.querySelectorAll<HTMLElement>('.hero-text');
  const dots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');
  const prev = document.getElementById('hero-prev');
  const next = document.getElementById('hero-next');
  const counter = document.getElementById('hero-current');

  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;
  const INTERVAL = 6500;

  const go = (i: number) => {
    current = (i + slidesEls.length) % slidesEls.length;
    slidesEls.forEach((s, k) => {
      const active = k === current;
      s.classList.toggle('opacity-100', active);
      s.classList.toggle('z-10', active);
      s.classList.toggle('opacity-0', !active);
      s.classList.toggle('z-0', !active);
      s.setAttribute('aria-hidden', active ? 'false' : 'true');
    });
    textEls.forEach((t, k) => {
      const active = k === current;
      t.classList.toggle('opacity-100', active);
      t.classList.toggle('opacity-0', !active);
      t.classList.toggle('translate-y-0', active);
      t.classList.toggle('translate-y-4', !active);
      t.classList.toggle('pointer-events-none', !active);
    });
    dots.forEach((d, k) => {
      const active = k === current;
      d.classList.toggle('w-16', active);
      d.classList.toggle('bg-accent', active);
      d.classList.toggle('w-6', !active);
      d.classList.toggle('bg-white/30', !active);
      d.classList.toggle('hover:bg-white/60', !active);
    });
    if (counter) counter.textContent = String(current + 1).padStart(2, '0');
  };

  const start = () => {
    stop();
    timer = setInterval(() => go(current + 1), INTERVAL);
  };
  const stop = () => {
    if (timer) clearInterval(timer);
    timer = null;
  };

  dots.forEach((d) =>
    d.addEventListener('click', () => {
      const i = Number(d.dataset.index);
      go(i);
      start();
    })
  );
  prev?.addEventListener('click', () => { go(current - 1); start(); });
  next?.addEventListener('click', () => { go(current + 1); start(); });

  const slider = document.getElementById('hero-slider');
  slider?.addEventListener('mouseenter', stop);
  slider?.addEventListener('mouseleave', start);

  start();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { products } from '../data/products';
import { regions } from '../data/regions';
import { decorationServices } from '../data/decoration';
import { sectors } from '../data/sectors';
import References from '../components/References.astro';
import { blogPosts as allBlogPosts } from '../data/blog';

const title = 'Ökmen Havalandırma | Diyarbakır Endüstriyel Havalandırma Çözümleri';
const description = 'Diyarbakır merkezli endüstriyel havalandırma, klima santrali, toz toplama, davlumbaz ve baca sistemleri. 15+ yıl tecrübe, 500+ proje, CE belgeli ürünler, 7/24 servis.';

const featuredProducts = products.slice(0, 6);

const stats = [
  { value: '500+', label: 'Tamamlanan Proje' },
  { value: '15+', label: 'Yıllık Tecrübe' },
  { value: '%100', label: 'Müşteri Memnuniyeti' },
  { value: '7/24', label: 'Servis Desteği' },
];

const reasons = [
  {
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    title: 'CE Belgeli Kalite',
    desc: 'Tüm ürünlerimiz Eurovent ve TSE sertifikalıdır, AB standartlarında imal edilir.',
  },
  {
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    title: 'Anahtar Teslim Çözüm',
    desc: 'Keşiften mühendisliğe, imalattan montaja tüm süreç tek elden yürütülür.',
  },
  {
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Şeffaf Fiyatlandırma',
    desc: 'Ücretsiz keşif, detaylı hesap raporu ve sürpriz olmayan teklifler.',
  },
  {
    icon: 'M3 12l2-2 4 4 8-8 4 4M3 12v6a2 2 0 002 2h14a2 2 0 002-2v-6',
    title: 'Yüksek Performans',
    desc: 'Enerji verimli motor seçimi ve doğru hesaplama ile düşük işletme maliyeti.',
  },
  {
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
    title: '2 Yıl Tam Garanti',
    desc: 'Üretim ve montaj garantili, ömür boyu yedek parça ve teknik destek.',
  },
  {
    icon: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z',
    title: 'Türkiye Geneli Hizmet',
    desc: 'Diyarbakır merkezimizden 81 ile ve Avrupa\'ya kadar hızlı tedarik ve montaj.',
  },
];

const galleryImages = [
  { src: '/images/lib/pexels-586744.webp', alt: 'Endüstriyel havalandırma', span: 'md:col-span-2 md:row-span-2' },
  { src: '/images/lib/pexels-2760243.webp', alt: 'Toz toplama sistemi', span: '' },
  { src: '/images/lib/pexels-2544829.webp', alt: 'Davlumbaz montajı', span: '' },
  { src: '/images/lib/pexels-459728.webp', alt: 'Endüstriyel baca', span: 'md:row-span-2' },
  { src: '/images/lib/pexels-3964736.webp', alt: 'Klima santrali', span: '' },
  { src: '/images/lib/pexels-2569842.webp', alt: 'Çelik baca', span: '' },
];

const blogPosts = allBlogPosts.slice(0, 3);

const referenceLogos = ['ASTAŞ', 'EUROVENT', 'TSE', 'BOSCH', 'SIEMENS', 'DAIKIN', 'CARRIER', 'TROX'];
---

<BaseLayout title={title} description={description} preloadImage="/images/hero/slide-1.webp">
  <Hero />

  <!-- DRAMATIC WELCOME SHOWCASE — asymmetric, magazine-style intro -->
  <section class="relative overflow-hidden bg-white py-20 md:py-32">
    <!-- Massive watermark "Ö" letter -->
    <div class="absolute top-1/2 -translate-y-1/2 -left-12 md:-left-24 pointer-events-none select-none z-0" aria-hidden="true">
      <div class="font-serif font-bold text-pale/30 leading-none" style="font-size: clamp(20rem, 40vw, 40rem);">Ö</div>
    </div>

    <div class="relative container-x grid lg:grid-cols-12 gap-10 lg:gap-16 items-center z-10">
      <!-- Left: copy block -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="accent-strip mb-5">
          <span class="text-xs uppercase tracking-[0.22em] font-semibold text-accent">Diyarbakır · 2010'dan Beri</span>
        </div>
        <h2 class="display-headline text-giant text-primary mb-6 text-balance leading-[0.95]">
          Havayı <span class="gradient-text">mühendis</span> gibi düşünüyoruz.
        </h2>
        <p class="text-lg text-slate-600 mb-6 leading-relaxed text-pretty">
          Endüstride bir tesisin verimliliği duvarlarla değil, <strong class="text-primary">havayla</strong> ölçülür. Doğru hesaplanmış havalandırma; işçi konforunu, üretim hızını, ürün kalitesini ve enerji faturasını aynı anda etkiler.
        </p>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed text-pretty">
          Ökmen Havalandırma olarak her projeye <strong class="text-primary">mühendis</strong> hassasiyetiyle yaklaşıyor; 20+ ürün kategorimizle keşiften servise tek çatı altında çözüm sunuyoruz.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/hakkimizda/" class="btn-primary">
            Bizi Tanıyın
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/galeri/" class="btn-secondary">Projelerimiz</a>
        </div>
      </div>

      <!-- Right: dramatic photo stack -->
      <div class="lg:col-span-7 order-1 lg:order-2 relative">
        <div class="grid grid-cols-12 gap-3 md:gap-4 relative">
          <!-- Big main photo -->
          <div class="col-span-12 md:col-span-8 relative">
            <div class="brand-photo-wrap aspect-[4/3] md:aspect-[3/4] rounded-3xl shadow-2xl">
              <img src="/images/lib/pexels-586744.webp" alt="Ökmen endüstriyel havalandırma tesisi" loading="lazy"/>
              <div class="absolute top-5 left-5 flex items-center gap-2 text-white">
                <span class="relative flex w-2.5 h-2.5">
                  <span class="absolute inset-0 rounded-full bg-accent animate-ping"></span>
                  <span class="relative w-2.5 h-2.5 rounded-full bg-accent"></span>
                </span>
                <span class="text-xs uppercase tracking-[0.18em] font-semibold">Saha · Aktif</span>
              </div>
              <div class="absolute bottom-6 left-6 right-6 text-white">
                <div class="text-xs uppercase tracking-[0.18em] text-accent mb-1">Bugün</div>
                <div class="font-serif text-xl md:text-2xl font-semibold leading-tight">Diyarbakır OSB · Tekstil Tesisi Montajı</div>
              </div>
            </div>
          </div>

          <!-- Secondary photo + floating stat card -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-3 md:gap-4">
            <div class="brand-photo-wrap aspect-square md:aspect-auto md:flex-1 rounded-3xl shadow-xl">
              <img src="/images/lib/pexels-3964736.webp" alt="Klima santrali" loading="lazy"/>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <div class="text-[10px] uppercase tracking-[0.18em] text-accent mb-0.5">Ürün</div>
                <div class="font-serif text-base font-semibold">Klima Santrali</div>
              </div>
            </div>

            <div class="bg-primary text-white rounded-3xl p-6 shadow-xl relative overflow-hidden">
              <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-accent/20"></div>
              <div class="relative">
                <div class="font-serif text-4xl md:text-5xl font-bold leading-none mb-1">500+</div>
                <div class="text-xs uppercase tracking-[0.18em] text-pale/80">Tamamlanan Proje</div>
                <div class="mt-4 flex items-center gap-2 text-xs text-pale/70">
                  <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.4-6.3-4.6L5.7 21l2.3-7.4-6-4.4h7.6L12 2z"/></svg>
                  <span>Müşteri memnuniyeti %100</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating glass card overlapping -->
        <div class="hidden lg:flex absolute -bottom-8 -left-8 bg-white rounded-2xl shadow-2xl border border-slate-100 p-5 items-center gap-4 max-w-xs z-20">
          <div class="w-14 h-14 rounded-2xl bg-gradient-primary text-white flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <div class="font-serif text-base font-bold text-primary leading-tight">CE & Eurovent Sertifikalı</div>
            <div class="text-xs text-slate-500 mt-0.5">AB standartlarında üretim</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE: Scrolling product names — bold visual signature -->
  <section class="bg-primary text-white py-6 overflow-hidden border-y border-white/10">
    <div class="marquee flex items-center gap-12 whitespace-nowrap">
      {[...products, ...products].map((p) => (
        <a href={`/urunler/${p.slug}/`} class="flex items-center gap-4 group">
          <span class="font-serif text-2xl md:text-3xl font-semibold text-white group-hover:text-accent transition uppercase tracking-tight">{p.title}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-accent opacity-50"></span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .marquee {
      animation: marquee 60s linear infinite;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .marquee:hover { animation-play-state: paused; }
  </style>

  <!-- HANGİ İŞLETMESİNİZ? — sektör seçici (en yüksek konversiyon noktası) -->
  <section class="section bg-gradient-to-b from-white via-pale/20 to-white">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="eyebrow">İşletmenize Özel</div>
        <h2 class="section-title">Hangi İşletmeyi Yönetiyorsunuz?</h2>
        <p class="section-subtitle mx-auto">
          Restoran açıyorsanız ihtiyacınız <strong>davlumbaz + baca</strong>; ofis için <strong>klima santrali</strong>; fabrika için <strong>toz toplama</strong>. İşletmenizi seçin, size özel paket önerimizi gösterelim.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {sectors.map((s, i) => (
          <a
            href={`/isletmeler/${s.slug}/`}
            class={`group relative rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover hover:-translate-y-1 transition-all duration-300 ${i === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}
            data-reveal
          >
            <div class={`brand-photo-wrap aspect-[4/3] ${i === 0 ? 'lg:aspect-[16/15]' : ''}`}>
              <img src={s.heroImage} alt={s.title} loading="lazy" class="transition-transform duration-700 group-hover:scale-110"/>

              <!-- Emoji rozeti -->
              <div class="absolute top-3 left-3 z-10 w-11 h-11 rounded-2xl bg-white/95 backdrop-blur flex items-center justify-center text-2xl shadow-card">
                {s.emoji}
              </div>

              <!-- Başlık + CTA alt bant -->
              <div class="absolute bottom-0 left-0 right-0 z-10 p-4 md:p-5 text-white">
                <div class="text-[10px] uppercase tracking-[0.16em] text-pale/85 mb-1 font-semibold">{s.short}</div>
                <div class={`font-serif font-bold leading-tight mb-2 ${i === 0 ? 'text-2xl md:text-3xl' : 'text-lg md:text-xl'}`}>
                  {s.title}
                </div>
                <div class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-accent group-hover:text-white transition">
                  Paketi Gör
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Yardım metni -->
      <div class="mt-10 flex flex-col md:flex-row items-center justify-center gap-4 p-5 rounded-2xl bg-primary text-white">
        <div class="flex items-center gap-3">
          <svg class="w-6 h-6 text-accent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="text-sm md:text-base"><strong>Kararsız mısınız?</strong> İşletmenizi anlatın, biz size hangi pakete uygun olduğunuzu söyleyelim.</span>
        </div>
        <a href="https://wa.me/905309009344" target="_blank" rel="noopener" class="btn-accent text-sm flex-shrink-0">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.5 3.5A11.94 11.94 0 0012 0C5.4 0 .03 5.37.03 11.97c0 2.1.55 4.16 1.6 5.98L0 24l6.22-1.62a11.97 11.97 0 005.78 1.47h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.48-8.38z"/></svg>
          WhatsApp'tan Sor
        </a>
      </div>
    </div>
  </section>

  <section id="hizmetler" class="section">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="eyebrow">Ne Yapıyoruz?</div>
        <h2 class="section-title">Öne Çıkan Çözümlerimiz</h2>
        <p class="section-subtitle mx-auto">
          Endüstriden ticarete, fabrikadan otele kadar geniş bir yelpazede uzman olduğumuz ana ürün gruplarımız.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProducts.map((p) => <ProductCard product={p} />)}
      </div>

      <div class="text-center mt-10">
        <a href="/urunler/" class="btn-primary">
          Tüm 20+ Ürünü Görüntüle
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-pale/30">
    <div class="container-x grid lg:grid-cols-2 gap-12 items-center">
      <div class="relative" data-reveal>
        <div class="absolute -top-6 -left-6 w-32 h-32 bg-accent/20 rounded-3xl"></div>
        <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/10 rounded-3xl"></div>
        <img
          src="/images/lib/pexels-3846205.webp"
          alt="Ökmen Havalandırma Mühendisleri"
          class="relative rounded-2xl shadow-card-hover w-full"
          loading="lazy"
        />
        <div class="absolute -bottom-6 left-6 right-6 bg-white rounded-2xl p-5 shadow-card-hover flex items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-gradient-accent flex items-center justify-center text-white">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <div class="font-serif text-lg font-semibold text-primary leading-tight">CE & Eurovent</div>
            <div class="text-xs text-slate-600">Sertifikalı Üretim</div>
          </div>
        </div>
      </div>

      <div data-reveal>
        <div class="eyebrow">Hakkımızda</div>
        <h2 class="section-title">15+ Yıllık Tecrübe, Mühendis Yaklaşımı</h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          Ökmen Havalandırma olarak Diyarbakır merkezimizden Güneydoğu Anadolu başta olmak üzere tüm Türkiye'ye ve Avrupa'ya endüstriyel havalandırma çözümleri sunuyoruz.
        </p>
        <p class="text-slate-700 leading-relaxed mb-6">
          Isıtma, soğutma, makine ithalat-ihracat alanlarındaki uzmanlığımızla her ölçekte projeye anahtar teslim çözüm üretiyoruz. Hesaplama, projelendirme, imalat, montaj ve servis — tüm süreç tek elden Ökmen güvencesiyle.
        </p>
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <div class="font-semibold text-primary text-sm">Mühendislik</div>
              <div class="text-xs text-slate-600">Hesap & Tasarım</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <div class="font-semibold text-primary text-sm">Üretim</div>
              <div class="text-xs text-slate-600">Modern Tesis</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <div class="font-semibold text-primary text-sm">Montaj</div>
              <div class="text-xs text-slate-600">Uzman Ekip</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <div class="font-semibold text-primary text-sm">Servis</div>
              <div class="text-xs text-slate-600">7/24 Destek</div>
            </div>
          </div>
        </div>
        <a href="/hakkimizda/" class="btn-primary">Bizi Daha Yakından Tanıyın</a>
      </div>
    </div>
  </section>

  <!-- MÜŞTERİ YORUMLARI — sosyal kanıt -->
  <section class="section bg-white">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="eyebrow">Müşteri Yorumları</div>
        <h2 class="section-title">Bizimle Çalışanlar Ne Diyor?</h2>
        <p class="section-subtitle mx-auto">500+ tamamlanmış projeden kısa kareler — sektörden gerçek deneyimler.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-pale/30 rounded-2xl p-7 border border-pale/60" data-reveal>
          <div class="flex gap-0.5 mb-4 text-accent">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.4-6.3-4.6L5.7 21l2.3-7.4-6-4.4h7.6L12 2z"/></svg>
            ))}
          </div>
          <p class="text-slate-700 leading-relaxed mb-5 text-pretty">
            "OSB'deki tekstil fabrikamız için klima santrali kurulumu yaptılar. Ekip mühendis yaklaşımıyla geldi, hesap raporu net, montaj tertemizdi. Bir yıldır sıfır arıza."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-full bg-primary text-white flex items-center justify-center font-serif font-bold">MK</div>
            <div>
              <div class="font-semibold text-primary text-sm">Mehmet K.</div>
              <div class="text-xs text-slate-500">Tekstil İşletme Müdürü · Diyarbakır</div>
            </div>
          </div>
        </div>

        <div class="bg-pale/30 rounded-2xl p-7 border border-pale/60" data-reveal>
          <div class="flex gap-0.5 mb-4 text-accent">

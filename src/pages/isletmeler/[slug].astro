---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { sectors, type Sector } from '../../data/sectors';
import { products } from '../../data/products';
import { decorationServices } from '../../data/decoration';
import { breadcrumb, service, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return sectors.map((sector) => ({
    params: { slug: sector.slug },
    props: { sector },
  }));
}

const { sector } = Astro.props as { sector: Sector };

const title = `${sector.title} İçin Havalandırma | ${sector.seo}`;
const description = `${sector.title} işletmesi için anahtar teslim havalandırma çözümleri. ${sector.description}`;

const recommendedProducts = sector.recommendedProducts
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean) as typeof products;

const recommendedDecoration = sector.recommendedDecoration
  .map((slug) => decorationServices.find((s) => s.slug === slug))
  .filter(Boolean) as typeof decorationServices;

const AREA = ['Diyarbakır', 'Şanlıurfa', 'Batman', 'Mardin', 'Gaziantep', 'Elazığ'];

const serviceSchema = service({
  serviceType: `${sector.title} Havalandırma Çözümleri`,
  description: sector.description,
  areaServed: AREA,
});

const faqSchema = faqPage([
  {
    q: `${sector.title} için havalandırma keşfi ücretli mi?`,
    a: 'Hayır. Diyarbakır ve çevre illerde yerinde keşif ve fiyat teklifimiz ücretsizdir. İşletmenize gelip ihtiyacınızı inceliyor, size özel projelendirilmiş teklif sunuyoruz.',
  },
  {
    q: `${sector.title} havalandırma kurulumu ne kadar sürer?`,
    a: 'Proje kapsamına göre değişir; keşif sonrası net süre ve teslim tarihi veriyoruz. Açılış/teslim tarihinize göre planlama yapıp anahtar teslim tamamlıyoruz.',
  },
  {
    q: `${sector.title} için hangi sistemleri kuruyorsunuz?`,
    a: `${sector.description} Davlumbaz, baca, filtre, klima ve kanal sistemlerini tek elden projelendirip montajını yapıyoruz.`,
  },
]);

const breadcrumbSchema = breadcrumb([
  { name: 'Ana Sayfa', path: '/' },
  { name: 'İşletmeler', path: '/isletmeler/' },
  { name: sector.title, path: `/isletmeler/${sector.slug}/` },
]);
---

<BaseLayout title={title} description={description} image={sector.heroImage} schema={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <!-- HERO -->
  <section class="relative bg-gradient-primary text-white py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-35 bg-cover bg-center" style={`background-image: url('${sector.heroImage}')`}></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/75 to-primary"></div>

    <div class="relative container-x">
      <nav class="text-sm text-pale/70 mb-4">
        <a href="/" class="hover:text-white">Ana Sayfa</a>
        <span class="mx-2">/</span>
        <a href="/isletmeler/" class="hover:text-white">İşletmeler</a>
        <span class="mx-2">/</span>
        <span class="text-white">{sector.title}</span>
      </nav>

      <div class="flex items-center gap-3 mb-3">
        <span class="text-5xl">{sector.emoji}</span>
        <div class="text-xs uppercase tracking-[0.2em] text-accent font-bold">{sector.short}</div>
      </div>
      <h1 class="font-serif text-4xl md:text-6xl font-bold mb-4 text-balance">{sector.title} için Havalandırma</h1>
      <p class="text-lg md:text-xl text-pale/95 max-w-3xl text-balance leading-relaxed">{sector.description}</p>

      <div class="mt-7 flex flex-wrap gap-4 text-sm">
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Bütçe aralığı: <strong class="text-white">{sector.budgetRange}</strong></span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Süre: <strong class="text-white">{sector.timeline}</strong></span>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="https://wa.me/905309009344" target="_blank" rel="noopener" class="btn-accent text-base px-7 py-3.5 shadow-xl">
          Ücretsiz Keşif Al
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="tel:+905309009344" class="btn-ghost text-base px-7 py-3.5">+90 530 900 93 44</a>
      </div>
    </div>
  </section>

  <!-- PROBLEM / VAAD karşılaştırması -->
  <section class="section">
    <div class="container-x grid lg:grid-cols-2 gap-10">
      <!-- Sorunlar -->
      <div class="bg-red-50/40 rounded-2xl p-7 md:p-8 border border-red-100">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-11 h-11 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-primary">Yaşadığınız Sorunlar</h2>
        </div>
        <ul class="space-y-3">
          {sector.problems.map((p) => (
            <li class="flex items-start gap-3 text-slate-700">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-red-200 text-red-700 flex items-center justify-center mt-0.5 text-xs font-bold">✕</span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Çözümler -->
      <div class="bg-green-50/40 rounded-2xl p-7 md:p-8 border border-green-100">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-11 h-11 rounded-xl bg-green-100 text-green-700 flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-primary">Bizim Vaadimiz</h2>
        </div>
        <ul class="space-y-3">
          {sector.promises.map((p) => (
            <li class="flex items-start gap-3 text-slate-700">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-200 text-green-700 flex items-center justify-center mt-0.5 text-xs font-bold">✓</span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ÖNERILEN ÜRÜNLER -->
  <section class="section bg-pale/30">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="eyebrow">Size Önerimiz</div>
        <h2 class="section-title">{sector.title} İçin Standart Paket</h2>
        <p class="section-subtitle mx-auto">Bu ürün ve hizmetlerle anahtar teslim bir kurulum yapıyoruz. İhtiyacınıza göre çıkarma/ekleme yapılabilir.</p>
      </div>

      <div class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Havalandırma Ürünleri</div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-10">
        {recommendedProducts.map((p) => (
          <a href={`/urunler/${p.slug}/`} class="group bg-white rounded-xl p-4 border border-slate-100 hover:border-accent hover:shadow-card transition text-center">
            <div class="w-12 h-12 mx-auto rounded-xl bg-pale/50 group-hover:bg-primary text-primary group-hover:text-white flex items-center justify-center mb-3 transition">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/></svg>
            </div>
            <div class="text-xs font-semibold text-primary leading-tight">{p.title}</div>
          </a>
        ))}
      </div>

      <div class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-secondary">Mir Dekorasyon ile Birlikte</div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {recommendedDecoration.map((s) => (
          <a href={`/yapi-dekorasyon/${s.slug}/`} class="group bg-white rounded-xl p-4 border border-slate-100 hover:border-accent hover:shadow-card transition text-center">
            <div class="w-12 h-12 mx-auto rounded-xl bg-pale/50 group-hover:bg-secondary text-primary group-hover:text-white flex items-center justify-center mb-3 transition">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/></svg>
            </div>
            <div class="text-xs font-semibold text-primary leading-tight">{s.title}</div>
          </a>
        ))}
      </div>

      <div class="mt-10 p-6 rounded-2xl bg-gradient-primary text-white text-center">
        <p class="text-lg mb-2"><strong>Bütçe aralığı:</strong> {sector.budgetRange} · <strong>Süre:</strong> {sector.timeline}</p>
        <p class="text-sm text-pale/85">Kesin fiyat için yerinde ücretsiz keşif yapıyoruz. Hiçbir ücret talep etmiyoruz.</p>
      </div>
    </div>
  </section>

  <!-- ÖRNEK VAKA -->
  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="relative">
          <div class="brand-photo-wrap aspect-[5/4] rounded-2xl shadow-card-hover">
            <img src={sector.heroImage} alt={sector.caseStudy.title} loading="lazy"/>
            <div class="absolute bottom-5 left-5 right-5 text-white">
              <div class="text-xs uppercase tracking-[0.18em] text-accent mb-1">Örnek Vaka</div>
              <div class="font-serif text-xl font-semibold">{sector.caseStudy.title}</div>
            </div>
          </div>
        </div>
        <div>
          <div class="eyebrow">Gerçek Bir Proje</div>
          <h2 class="section-title">{sector.caseStudy.title}</h2>
          <p class="text-slate-700 leading-relaxed mb-6 text-lg">
            "{sector.caseStudy.summary}"
          </p>
          <div class="flex gap-3">
            <a href="/galeri/" class="btn-secondary">Daha Fazla Proje</a>
            <a href="https://wa.me/905309009344" target="_blank" rel="noopener" class="btn-primary">Benzer Proje İçin Yaz</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- İLETİŞİM -->
  <section class="section bg-pale/30">
    <div class="container-x grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2">
        <div class="eyebrow">Hemen Başlayalım</div>
        <h2 class="section-title">{sector.title} İçin Teklif</h2>
        <p class="section-subtitle mb-6">İşletmenizin metrekaresi, konumu ve hizalanma talebinizi paylaşın — 24 saatte detaylı teklif gönderelim.</p>

        <div class="space-y-3">
          <a href="tel:+905309009344" class="flex items-center gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-primary hover:shadow-card transition">
            <div class="w-12 h-12 rounded-xl bg-primary text-white flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.9L8.09 10.91a16 16 0 006 6l1.69-1.38a2 2 0 011.9-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A17 17 0 013 5z"/></svg>
            </div>
            <div>
              <div class="text-xs text-slate-500">Hemen ara</div>
              <div class="font-semibold text-primary">+90 530 900 93 44</div>
            </div>
          </a>
          <a href="https://wa.me/905309009344" target="_blank" rel="noopener" class="flex items-center gap-4 p-4 rounded-xl bg-white border border-slate-200 hover:border-[#25D366] hover:shadow-card transition">
            <div class="w-12 h-12 rounded-xl bg-[#25D366] text-white flex items-center justify-center">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.5 3.5A11.94 11.94 0 0012 0C5.4 0 .03 5.37.03 11.97c0 2.1.55 4.16 1.6 5.98L0 24l6.22-1.62a11.97 11.97 0 005.78 1.47h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.48-8.38z"/></svg>
            </div>
            <div>
              <div class="text-xs text-slate-500">WhatsApp</div>
              <div class="font-semibold text-primary">5 dk içinde dönüş</div>
            </div>
          </a>
        </div>
      </div>
      <div class="lg:col-span-3">
        <ContactForm defaultService={sector.title} />
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import { regions } from '../../data/regions';
import { products } from '../../data/products';

export function getStaticPaths() {
  return regions.map((region) => ({
    params: { slug: region.slug },
    props: { region },
  }));
}

const { region } = Astro.props;

const title = `${region.title} | Ökmen Havalandırma`;
const description = region.description;

const featuredProducts = products.slice(0, 6);

const serviceSchema = {
  '@type': 'Service',
  serviceType: 'Endüstriyel Havalandırma',
  provider: { '@type': 'LocalBusiness', name: 'Ökmen Havalandırma' },
  areaServed: { '@type': 'City', name: region.city },
  description: region.description,
};
---

<BaseLayout title={title} description={description} image={region.heroImage} schema={serviceSchema}>
  <section class="relative bg-gradient-primary text-white py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-30 bg-cover bg-center" style={`background-image: url('${region.heroImage}')`}></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/80 to-primary"></div>

    <div class="relative container-x">
      <nav class="text-sm text-pale/70 mb-4" aria-label="Ekmek kırıntısı">
        <a href="/" class="hover:text-white">Ana Sayfa</a>
        <span class="mx-2">/</span>
        <span class="text-pale/70">Bölgeler</span>
        <span class="mx-2">/</span>
        <span class="text-white">{region.city}</span>
      </nav>

      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <div class="eyebrow text-accent mb-0">{region.city}, Türkiye</div>
      </div>
      <h1 class="font-serif text-4xl md:text-6xl font-bold mb-4 text-balance">{region.title}</h1>
      <p class="text-lg md:text-xl text-pale/90 max-w-3xl text-balance">{region.intro}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#teklif" class="btn-accent">Ücretsiz Keşif Talep Et</a>
        <a href="tel:+905309009344" class="btn-ghost">+90 530 900 93 44</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div class="eyebrow">{region.city} İçin Çözüm</div>
        <h2 class="section-title text-3xl md:text-4xl">Şehre Özel Mühendislik Yaklaşımımız</h2>

        <div class="prose prose-slate max-w-none">
          <h3 class="font-serif text-xl font-semibold text-primary mt-6 mb-3">İklim ve Coğrafya</h3>
          <p class="text-slate-700 leading-relaxed">{region.climate}</p>

          <h3 class="font-serif text-xl font-semibold text-primary mt-6 mb-3">Sanayi ve Hizmet Alanlarımız</h3>
          <p class="text-slate-700 leading-relaxed">{region.industrial}</p>

          <h3 class="font-serif text-xl font-semibold text-primary mt-6 mb-3">{region.city}'da Sunduğumuz Hizmetler</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 not-prose">
            {region.services.map((s) => (
              <li class="flex items-start gap-3 text-slate-700">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-accent/20 text-accent flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </span>
                <span>{s}</span>
              </li>
            ))}
          </ul>

          <h3 class="font-serif text-xl font-semibold text-primary mt-6 mb-3">Hizmet Verdiğimiz İlçeler</h3>
          <div class="flex flex-wrap gap-2 not-prose">
            {region.districts.map((d) => (
              <span class="px-3 py-1.5 text-sm rounded-full bg-pale/60 text-primary font-medium border border-pale">{d}</span>
            ))}
          </div>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="bg-pale/40 rounded-2xl p-6 border border-pale">
          <h3 class="font-serif text-xl font-semibold text-primary mb-4">Hızlı İletişim</h3>
          <a href="tel:+905309009344" class="flex items-center gap-3 mb-3 group">
            <div class="w-10 h-10 rounded-lg bg-primary text-white flex items-center justify-center group-hover:bg-secondary transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-.45 1.9L8.09 10.91a16 16 0 006 6l1.69-1.38a2 2 0 011.9-.45l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A17 17 0 013 5z"/></svg>
            </div>
            <div>
              <div class="text-xs text-slate-500">Telefon</div>
              <div class="font-semibold text-primary group-hover:text-secondary transition">+90 530 900 93 44</div>
            </div>
          </a>
          <a href="https://wa.me/905309009344" target="_blank" rel="noopener" class="flex items-center gap-3 mb-3 group">
            <div class="w-10 h-10 rounded-lg bg-[#25D366] text-white flex items-center justify-center group-hover:bg-[#1ebe57] transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.5 3.5A11.94 11.94 0 0012 0C5.4 0 .03 5.37.03 11.97c0 2.1.55 4.16 1.6 5.98L0 24l6.22-1.62a11.97 11.97 0 005.78 1.47h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.48-8.38zM12 21.8c-1.85 0-3.66-.5-5.24-1.43l-.38-.22-3.7.97.99-3.6-.25-.37A9.85 9.85 0 012.2 11.97C2.2 6.57 6.6 2.17 12 2.17s9.8 4.4 9.8 9.8c0 5.4-4.4 9.83-9.8 9.83z"/></svg>
            </div>
            <div>
              <div class="text-xs text-slate-500">WhatsApp</div>
              <div class="font-semibold text-primary group-hover:text-secondary transition">Anında yazışın</div>
            </div>
          </a>
          <a href="mailto:info@okmenhavalandirma.com" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-lg bg-secondary text-white flex items-center justify-center group-hover:bg-primary transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs text-slate-500">E-posta</div>
              <div class="font-semibold text-primary group-hover:text-secondary transition text-sm break-all">info@okmenhavalandirma.com</div>
            </div>
          </a>
        </div>

        <div class="bg-white rounded-2xl shadow-card p-6">
          <h3 class="font-serif text-xl font-semibold text-primary mb-4">Neden Ökmen?</h3>
          <ul class="space-y-2.5 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="text-accent font-bold">✓</span> 15+ yıl tecrübe</li>
            <li class="flex items-start gap-2"><span class="text-accent font-bold">✓</span> 500+ tamamlanmış proje</li>
            <li class="flex items-start gap-2"><span class="text-accent font-bold">✓</span> CE belgeli ürünler</li>
            <li class="flex items-start gap-2"><span class="text-accent font-bold">✓</span> 2 yıl garanti</li>
            <li class="flex items-start gap-2"><span class="text-accent font-bold">✓</span> 7/24 servis</li>
            <li class="flex items-start gap-2"><span class="text-accent font-bold">✓</span> Yerel mühendis kadrosu</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-pale/20">
    <div class="container-x">
      <div class="flex items-end justify-between mb-10 gap-4">
        <div>
          <div class="eyebrow">Popüler Ürünler</div>
          <h2 class="section-title text-3xl md:text-4xl">{region.city}'da Talep Görenler</h2>
        </div>
        <a href="/urunler" class="hidden md:inline-flex items-center gap-2 text-primary font-semibold hover:text-secondary transition">
          Tüm Ürünler
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section id="teklif" class="section">
    <div class="container-x grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-3">
        <ContactForm />
      </div>
      <div class="lg:col-span-2">
        <div class="eyebrow">Harita</div>
        <h2 class="section-title text-3xl md:text-4xl">{region.city} ve Çevresi</h2>
        <p class="text-slate-600 mb-6">
          {region.city} merkez ve tüm ilçelerde aynı kalite, aynı hızda hizmet veriyoruz.
        </p>
        <div class="rounded-2xl overflow-hidden shadow-card aspect-square">
          <iframe
            src={region.mapEmbed}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen={true}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`${region.city} Haritası`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-primary text-white">
    <div class="container-x text-center">
      <div class="eyebrow text-accent">Diğer Hizmet Bölgelerimiz</div>
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8">Türkiye Geneli Hizmet</h2>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {regions.filter((r) => r.slug !== region.slug).map((r) => (
          <a href={`/bolgeler/${r.slug}`} class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white hover:text-primary border border-white/20 transition font-medium">
            {r.city}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

          <div>
            <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">Toplam İlerleme</div>
            <div class="font-serif text-3xl md:text-4xl font-bold text-primary">
              {localTotal} / {total}
              <span class="text-base font-sans text-slate-500 ml-2">görsel yerel</span>
            </div>
          </div>
          <div class="text-right">
            <div class="font-serif text-4xl md:text-5xl font-bold text-accent">%{percent}</div>
            <div class="text-xs text-slate-500">tamamlandı</div>
          </div>
        </div>

        <div class="h-3 bg-slate-100 rounded-full overflow-hidden">

---
// ADMIN — Görsel envanteri ve yönetim sayfası
// Static, sadece bilgilendirme + adım rehberi. Header'da görünmez (noindex).
// Üretim ortamında bu sayfa basic auth veya gizli path arkasında olmalı.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, getProductImage } from '../../data/products';
import { decorationServices, getDecorationImage } from '../../data/decoration';
import { sectors } from '../../data/sectors';

// localImage var mı kontrolü
const productsWithStatus = products.map((p) => ({
  ...p,
  status: p.localImage ? 'local' : 'pexels',
  current: getProductImage(p),
}));

const decorationWithStatus = decorationServices.map((s) => ({
  ...s,
  status: s.localImage ? 'local' : 'pexels',
  current: getDecorationImage(s),
}));

const sectorsWithStatus = sectors.map((s) => ({
  ...s,
  status: s.heroImage?.startsWith('/sektor/') ? 'local' : 'pexels',
}));

const totalProducts = products.length;
const localProducts = productsWithStatus.filter((p) => p.status === 'local').length;
const localDecoration = decorationWithStatus.filter((s) => s.status === 'local').length;
const localSectors = sectorsWithStatus.filter((s) => s.status === 'local').length;
const total = products.length + decorationServices.length + sectors.length;
const localTotal = localProducts + localDecoration + localSectors;
const percent = Math.round((localTotal / total) * 100);
---

<BaseLayout
  title="Admin — Görsel Yönetim"
  description="Görsel envanteri ve import akışı"
  noindex={true}
>
  <section class="bg-slate-50 min-h-screen py-8 md:py-12">
    <div class="container-x">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs uppercase tracking-[0.18em] font-bold">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            Admin Paneli — Sadece Yöneticiler
          </div>
          <h1 class="font-serif text-3xl md:text-4xl font-bold text-primary">Görsel Yönetim</h1>
          <p class="text-sm text-slate-600 mt-1">AI ile üretilen ürün görsellerini siteye ekle, durumu görüntüle.</p>
        </div>

        <a href="/" class="btn-secondary text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Site'e Dön
        </a>
      </div>

      <!-- Genel ilerleme -->

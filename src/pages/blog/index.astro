---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Blog | Ökmen Havalandırma';
const description = 'Endüstriyel havalandırma, klima santrali, toz toplama ve iklimlendirme konularında uzman yazıları, sektörel haberler ve mühendislik rehberleri.';

const posts = [
  {
    slug: 'fan-secimi',
    title: 'Endüstriyel Havalandırmada Doğru Fan Seçimi',
    excerpt: 'Aksiyal mı, salyangoz mu, hücreli mi? Tesisinize uygun fan tipini seçmenin püf noktaları ve hesaplama yöntemleri.',
    image: 'https://images.pexels.com/photos/162568/oil-pump-jack-sunset-clouds-silhouette-162568.jpeg?auto=compress&cs=tinysrgb&w=1200',
    date: '12 Mayıs 2026',
    category: 'Mühendislik',
    readTime: '6 dk',
  },
  {
    slug: 'klima-santrali',
    title: 'Klima Santrali (AHU) Nedir, Nasıl Çalışır?',
    excerpt: 'Modern binalarda iklimlendirmenin kalbi olan AHU sistemlerinin çalışma prensibi ve seçim kriterleri.',
    image: 'https://images.pexels.com/photos/3964736/pexels-photo-3964736.jpeg?auto=compress&cs=tinysrgb&w=1200',
    date: '5 Mayıs 2026',
    category: 'Eğitim',
    readTime: '8 dk',
  },
  {
    slug: 'toz-toplama',
    title: 'Toz Toplama Sistemlerinde Jet-Pulse Teknolojisi',
    excerpt: 'Otomatik filtre temizleme nasıl çalışır, hangi sektörlerde tercih edilir ve verim hesabı.',
    image: 'https://images.pexels.com/photos/2760243/pexels-photo-2760243.jpeg?auto=compress&cs=tinysrgb&w=1200',
    date: '28 Nisan 2026',
    category: 'Teknoloji',
    readTime: '5 dk',
  },
  {
    slug: 'davlumbaz',
    title: 'Endüstriyel Davlumbaz Hesabı: Mutfak vs Üretim',
    excerpt: 'Restoran ve endüstriyel üretim alanları için davlumbaz boyutlandırma ve egzoz hesabı.',
    image: 'https://images.pexels.com/photos/2544829/pexels-photo-2544829.jpeg?auto=compress&cs=tinysrgb&w=1200',
    date: '20 Nisan 2026',
    category: 'Mühendislik',
    readTime: '7 dk',
  },
  {
    slug: 'enerji-verimi',
    title: 'HVAC Sistemlerinde Enerji Verimi: 7 İpucu',
    excerpt: 'İşletme maliyetlerini %30\'a kadar düşüren pratik enerji verimliliği önlemleri.',
    image: 'https://images.pexels.com/photos/3964705/pexels-photo-3964705.jpeg?auto=compress&cs=tinysrgb&w=1200',
    date: '14 Nisan 2026',
    category: 'Tasarruf',
    readTime: '6 dk',
  },
  {
    slug: 'baca-yangin',
    title: 'Endüstriyel Bacalarda Yangın Güvenliği',
    excerpt: 'Çelik baca sistemlerinde yangın güvenliği önlemleri ve TS EN standartları.',
    image: 'https://images.pexels.com/photos/459728/pexels-photo-459728.jpeg?auto=compress&cs=tinysrgb&w=1200',
    date: '8 Nisan 2026',
    category: 'Güvenlik',
    readTime: '5 dk',
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="relative bg-gradient-primary text-white py-20 md:py-28">
    <div class="absolute inset-0 opacity-20 bg-cover bg-center" style="background-image: url('https://images.pexels.com/photos/3964736/pexels-photo-3964736.jpeg?auto=compress&cs=tinysrgb&w=1920')"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/60 to-primary"></div>
    <div class="relative container-x text-center">
      <div class="eyebrow text-accent">Bilgi & Mühendislik</div>
      <h1 class="font-serif text-4xl md:text-6xl font-bold mb-4 text-balance">Blog</h1>
      <p class="text-lg md:text-xl text-pale/90 max-w-3xl mx-auto text-balance">
        Endüstriyel havalandırma, iklimlendirme ve filtrasyon konularında uzman yazıları.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <article class="group bg-white rounded-2xl overflow-hidden shadow-card card-hover">
            <a href={`/blog/${post.slug}/`} class="block">
              <div class="aspect-[5/3] overflow-hidden">
                <img src={post.image} alt={post.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"/>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                  <span class="px-2 py-0.5 rounded-full bg-pale/60 text-primary font-medium">{post.category}</span>
                  <span>•</span>
                  <span>{post.date}</span>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>
                <h2 class="font-serif text-xl font-semibold text-primary mb-2 group-hover:text-secondary transition line-clamp-2">
                  {post.title}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">{post.excerpt}</p>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-secondary group-hover:text-primary transition">
                  Yazıyı Oku
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-12 p-8 md:p-10 rounded-2xl bg-gradient-primary text-white text-center">
        <h2 class="font-serif text-2xl md:text-3xl font-bold mb-2">Yeni yazılarımızdan haberdar olun</h2>
        <p class="text-pale/80 mb-6 max-w-xl mx-auto">Ayda bir, sektör analizleri ve mühendislik rehberleri e-postanıza gelsin.</p>
        <form class="max-w-md mx-auto flex flex-col sm:flex-row gap-2">
          <input type="email" placeholder="e-posta adresiniz" required class="flex-1 px-4 py-3 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-accent"/>
          <button type="submit" class="btn-accent">Abone Ol</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../data/blog';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const siteUrl = 'https://okmenhavalandirma.com';
const pageUrl = `${siteUrl}/blog/${post.slug}/`;
const imageUrl = new URL(post.image, siteUrl).toString();

const title = `${post.title} | Ökmen Havalandırma`;
const description = post.excerpt;

// İlgili yazılar — bu yazı hariç ilk 3
const related = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);

const blogPostingSchema = {
  '@type': 'BlogPosting',
  '@id': pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  headline: post.title,
  description: post.excerpt,
  image: imageUrl,
  datePublished: post.isoDate,
  dateModified: post.isoDate,
  inLanguage: 'tr-TR',
  articleSection: post.category,
  author: { '@type': 'Organization', name: post.author, url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'Ökmen Havalandırma',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/logo.png` },
  },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
  ],
};

const schema = { '@graph': [blogPostingSchema, breadcrumbSchema] };

const waMessage = encodeURIComponent(
  `Merhaba, "${post.title}" yazınızı okudum. Bu konuda bir projem için bilgi almak istiyorum.`
);
---

<BaseLayout title={title} description={description} image={imageUrl} schema={schema}>
  <!-- HERO -->
  <section class="relative bg-gradient-primary text-white py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-25 bg-cover bg-center" style={`background-image: url('${post.image}')`}></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/80 to-primary"></div>

    <div class="relative container-x max-w-4xl">
      <!-- Görünür breadcrumb -->
      <nav class="text-sm text-pale/70 mb-5" aria-label="Ekmek kırıntısı">
        <a href="/" class="hover:text-white">Ana Sayfa</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-white">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-white">{post.title}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-3 text-xs text-pale/80 mb-4">
        <span class="px-2.5 py-1 rounded-full bg-accent/20 text-accent font-semibold">{post.category}</span>
        <span>•</span>
        <time datetime={post.isoDate}>{post.date}</time>
        <span>•</span>
        <span>{post.readingTime} okuma</span>
      </div>

      <h1 class="font-serif text-3xl md:text-5xl font-bold mb-4 text-balance leading-tight">{post.title}</h1>
      <p class="text-lg text-pale/90 max-w-3xl text-balance">{post.excerpt}</p>

      <div class="mt-6 flex items-center gap-3 text-sm text-pale/80">
        <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center font-serif font-bold text-white">Ö</span>
        <span>{post.author}</span>
      </div>
    </div>
  </section>

  <!-- İÇERİK -->
  <section class="section">
    <div class="container-x grid lg:grid-cols-12 gap-10">
      <!-- Ana içerik -->
      <article class="lg:col-span-8">
        <div class="rounded-2xl overflow-hidden shadow-card mb-8">
          <img src={post.image} alt={post.imageAlt} class="w-full h-auto object-cover" loading="eager" />
        </div>

        <div class="blog-body" set:html={post.body}></div>

        <!-- WhatsApp CTA kutusu -->
        <div class="mt-10 p-6 md:p-8 rounded-2xl bg-gradient-primary text-white">
          <h2 class="font-serif text-2xl font-bold mb-2">Projeniz için ücretsiz keşif ister misiniz?</h2>
          <p class="text-pale/85 mb-5 max-w-2xl">
            Bu yazıdaki çözümlerden tesisinize hangisi uygun? Ücretsiz keşif, detaylı hesap raporu ve şeffaf
            teklif için bizimle hemen iletişime geçin.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={`https://wa.me/905309009344?text=${waMessage}`}
              target="_blank"
              rel="noopener"
              class="btn-accent"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.5 3.5A11.94 11.94 0 0012 0C5.4 0 .03 5.37.03 11.97c0 2.1.55 4.16 1.6 5.98L0 24l6.22-1.62a11.97 11.97 0 005.78 1.47h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.48-8.38z"/></svg>
              WhatsApp'tan Yazın
            </a>
            <a href="/iletisim/" class="btn-ghost">Teklif Formu</a>
            <a href="tel:+905309009344" class="btn-ghost">Ara: +90 530 900 93 44</a>
          </div>
        </div>

        <!-- Alt navigasyon -->
        <div class="mt-8">
          <a href="/blog/" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-secondary transition">
            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            Tüm yazılara dön
          </a>
        </div>
      </article>

      <!-- Yan panel -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-2xl border border-slate-100 p-6 shadow-card bg-white lg:sticky lg:top-24">
          <h3 class="font-serif text-lg font-semibold text-primary mb-3">Ökmen Havalandırma</h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Diyarbakır merkezli endüstriyel havalandırma çözümleri. Keşiften servise tek elden, CE belgeli üretim,
            2 yıl garanti.
          </p>
          <a href="/urunler/" class="btn-primary w-full justify-center text-sm">
            Tüm Ürünleri Gör
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <div class="mt-4 pt-4 border-t border-slate-100">
            <div class="text-xs text-slate-500 mb-1">Hizmet bölgelerimiz</div>
            <div class="flex flex-wrap gap-1.5">
              <a href="/bolgeler/diyarbakir-havalandirma/" class="text-xs px-2 py-1 rounded-full bg-pale/60 text-primary hover:bg-pale transition">Diyarbakır</a>
              <a href="/bolgeler/sanliurfa-havalandirma/" class="text-xs px-2 py-1 rounded-full bg-pale/60 text-primary hover:bg-pale transition">Şanlıurfa</a>
              <a href="/bolgeler/gaziantep-havalandirma/" class="text-xs px-2 py-1 rounded-full bg-pale/60 text-primary hover:bg-pale transition">Gaziantep</a>
              <a href="/bolgeler/batman-havalandirma/" class="text-xs px-2 py-1 rounded-full bg-pale/60 text-primary hover:bg-pale transition">Batman</a>
              <a href="/bolgeler/mardin-havalandirma/" class="text-xs px-2 py-1 rounded-full bg-pale/60 text-primary hover:bg-pale transition">Mardin</a>
              <a href="/bolgeler/elazig-havalandirma/" class="text-xs px-2 py-1 rounded-full bg-pale/60 text-primary hover:bg-pale transition">Elazığ</a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- İLGİLİ YAZILAR -->
  <section class="section bg-pale/20">
    <div class="container-x">
      <div class="flex items-end justify-between mb-10 gap-4">
        <div>
          <div class="eyebrow">Bilgi Köşesi</div>
          <h2 class="section-title text-3xl md:text-4xl">İlgili Yazılar</h2>
        </div>
        <a href="/blog/" class="hidden md:inline-flex items-center gap-2 text-primary font-semibold hover:text-secondary transition">
          Tüm Yazılar
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {related.map((p) => (
          <article class="group bg-white rounded-2xl overflow-hidden shadow-card card-hover">
            <a href={`/blog/${p.slug}/`} class="block">
              <div class="aspect-[5/3] overflow-hidden">
                <img src={p.image} alt={p.imageAlt} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"/>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                  <span class="px-2 py-0.5 rounded-full bg-pale/60 text-primary font-medium">{p.category}</span>
                  <span>•</span>
                  <span>{p.date}</span>
                </div>
                <h3 class="font-serif text-xl font-semibold text-primary mb-2 group-hover:text-secondary transition line-clamp-2">
                  {p.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed line-clamp-2">{p.excerpt}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .blog-body {
    color: #334155;
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .blog-body > p {
    margin-bottom: 1.25rem;
  }
  .blog-body h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.25;
    color: #1a3a5c;
    margin-top: 2.25rem;
    margin-bottom: 0.9rem;
  }
  .blog-body h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 1.375rem;
    color: #1a3a5c;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .blog-body ul,
  .blog-body ol {
    margin: 0 0 1.25rem 0;
    padding-left: 1.4rem;
  }
  .blog-body ul { list-style: disc; }
  .blog-body ol { list-style: decimal; }
  .blog-body li {
    margin-bottom: 0.6rem;
    padding-left: 0.2rem;
  }
  .blog-body strong { color: #1a3a5c; font-weight: 600; }
  .blog-body a {
    color: #d97706;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }
  .blog-body a:hover { color: #1a3a5c; }
</style>
